<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AssemblyName>PlanCad_MoveToConnect_v3</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AutoCADDir Condition="'$(AutoCADDir)' == ''">C:\Program Files\Autodesk\AutoCAD 2027</AutoCADDir>
    <Plant3DDir Condition="'$(Plant3DDir)' == ''">$(AutoCADDir)\PLNT3D</Plant3DDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
    <Reference Include="AcCoreMgd"><HintPath>$(AutoCADDir)\accoremgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AcDbMgd"><HintPath>$(AutoCADDir)\acdbmgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AcMgd"><HintPath>$(AutoCADDir)\acmgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="PnP3dObjectsMgd"><HintPath>$(Plant3DDir)\PnP3dObjectsMgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="PnPCommonDbxMgd"><HintPath>$(AutoCADDir)\PnPCommonDbxMgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="PnP3dPipeUI"><HintPath>$(Plant3DDir)\PnP3dPipeUI.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
